# cp .env.example .env 해서 쓴다. .env는 커밋하지 않는다.

FLASK_APP=app
# 맥의 AirPlay 수신이 5000을 쓰므로 8000으로 띄운다
FLASK_RUN_PORT=8000
FLASK_RUN_HOST=127.0.0.1

# 거래소에 돌려줄 auth_url의 앞부분
PUBLIC_BASE_URL=http://127.0.0.1:8000
# dev | production. dev에서는 로컬 http 때문에 세션 쿠키 Secure를 끈다(D22).
EKYC_ENV=dev

# 시크릿 파일 경로 (기본값: instance/dev_secrets.json)
# EKYC_SECRETS_FILE=instance/dev_secrets.json
# 개별 시크릿 덮어쓰기: EKYC_SECRET_<이름 대문자, / 와 - 는 _>
# EKYC_SECRET_EKYC_DB=postgresql+psycopg://ekyc:ekyc@127.0.0.1:5432/ekyc

# Apache 뒤에 둘 때만 true. true일 때만 X-Real-IP를 믿는다.
TRUST_PROXY=false

# pytest를 PostgreSQL로 돌릴 때만 설정한다(없으면 SQLite 메모리)
# TEST_DATABASE_URL=postgresql+psycopg://ekyc:ekyc@127.0.0.1:5432/ekyc_test

# 실습 전용 테스트 문자 수신함 허용 IP (진단 범위 제외)
TEST_INBOX_ALLOWED_IPS=127.0.0.1,::1

# 얼굴 대조 백엔드 (D93)
#   fake        기본. 파일명 힌트로 판정한다. 시연·테스트 전용이고
#               이미지를 읽지 않으므로 강아지 사진도 '동일 인물'로 통과한다.
#   local       OpenCV로 실제 얼굴을 검출·대조한다. 얼굴 없는 사진은 E04로 걸러진다.
#               requirements-optional.txt 설치가 필요하다.
#               **카메라를 붙여 시연한다면 반드시 local 로 띄운다.** fake 로 두면
#               카메라 앞에 누가 있든 전부 통과해서 시연이 무의미해진다.
#               (파일로 돌리는 e2e 하네스는 samples/faces/ 에 실제 사진이 따로 필요하다)
#   rekognition AWS Rekognition CompareFaces. 배포 후 쓴다(IAM 역할로 인증).
FACE_MATCHER=fake

# 이미지 저장소: local(instance/uploads) | s3(AWS 배포 단계)
STORAGE_BACKEND=local
AWS_REGION=ap-northeast-2

# 모의 통신사 (자체 서명 인증서 고정)
CARRIER_BASE_URL=https://localhost:8443
CARRIER_CA_BUNDLE=carrier/certs/carrier.crt
# 모의 통신사가 뜨는 주소·포트(python -m carrier). 다른 호스트·컨테이너에서 부르면 0.0.0.0
CARRIER_BIND_HOST=127.0.0.1
CARRIER_PORT=8443
# 통신사 인증서에 넣을 이름(python -m carrier.make_certs). CARRIER_BASE_URL 의 호스트가 들어 있어야 한다.
CARRIER_CERT_HOSTS=localhost,127.0.0.1,host.docker.internal,carrier

# 수신함 위젯을 iframe으로 띄울 수 있는 위탁사 화면 출처(dev 전용, 쉼표 구분)
TEST_INBOX_FRAME_ANCESTORS=http://localhost:3000,http://127.0.0.1:3000

# ───────────────────────────────────────────────────────────────────────
# compose 스택(docker compose) 전용. 컨테이너 안팎의 주소가 달라서
# 위의 호스트 실행(flask run)용 값과 이름을 따로 둔다.
# 비워 두거나 지우면 괄호 안 기본값으로 뜬다.
# ───────────────────────────────────────────────────────────────────────

# 웹서버를 여는 호스트 주소와 포트 (127.0.0.1 / 9080 / 9443). 외부에서 받으면 0.0.0.0 / 80 / 443
WEB_BIND=127.0.0.1
WEB_HTTP_PORT=9080
WEB_HTTPS_PORT=9443
# Apache ServerName 과 ops/make_web_certs.sh 인증서 이름 (localhost). 배포 시 도메인
WEB_SERVER_NAME=localhost
# web.crt / web.key 가 있는 폴더 (./ops/certs). 공인 인증서를 쓰면 그 폴더
WEB_CERT_DIR=./ops/certs
# 브라우저가 접속하는 주소. 끝에 / 를 붙이지 않는다. http→https 리다이렉트와 auth_url 에 쓴다.
STACK_PUBLIC_BASE_URL=https://localhost:9443
# 앱 컨테이너가 모의 통신사를 부르는 주소 (호스트에서 띄운 통신사)
STACK_CARRIER_BASE_URL=https://host.docker.internal:8443
# 통신사도 컨테이너로 띄우려면 아래 줄의 주석을 풀고, 위 주소를 https://carrier:8443 으로 바꾼다.
# 호스트에 파이썬을 깔지 않아도 된다(서버 배포용). 인증서에 carrier 이름이 들어 있어야 한다.
#COMPOSE_PROFILES=carrier
# 컨테이너에서 본 테스트 수신함 허용 IP. Apache 가 넘겨 준 실제 접속 IP 기준이다.
STACK_TEST_INBOX_ALLOWED_IPS=127.0.0.1,::1,172.16.0.0/12
# DB 비밀번호. 볼륨을 처음 만들 때만 적용된다.
POSTGRES_PASSWORD=ekyc
# 호스트로 여는 DB 포트(127.0.0.1 전용)
DB_HOST_PORT=5432

# ───────────────────────────────────────────────────────────────────────
# 취약 플래그 (진단 실습용). 기본은 전부 false.
# 켜려면 true로 바꾸고 앱을 다시 띄운다. **코드는 고치지 않는다.**
# 하나라도 켜져 있으면 기동 로그에 경고가 찍힌다.
# 웹서버(Apache) 설정 취약은 여기가 아니라 ops/apply_vuln.sh 로 전환한다.
# ───────────────────────────────────────────────────────────────────────

# CLAUDE.md 14장
VULN_W08=false   # IA-12가 다른 위탁사 건도 돌려준다 (불충분한 인가)
VULN_W09=false   # 얼굴 단계가 진위확인 통과를 확인하지 않는다 (프로세스 검증 누락)
VULN_W10=false   # 관리자 목록 JSON이 주민번호 원문을 돌려준다 (개인정보 과다 노출)
VULN_W14=false   # 명의 불일치와 미등록 번호를 다르게 응답한다 (가입 여부 열거)
VULN_W17=false   # 인증번호·휴대폰번호 원문을 로그에 남긴다 (민감정보 로깅)
VULN_C10=false   # 파기 배치가 저장소 파일을 남긴다 (불완전 파기)

# 홈페이지 자료실·문의에서만 쓰는 웹 점검용 (D90)
VULN_W01=false   # 자료실 검색을 문자열 연결로 만든다 (SQL 인젝션)
VULN_W02=false   # 관리자 문의 상세를 escape 없이 출력한다 (저장형 XSS)
VULN_W05=false   # 다운로드가 file 값을 그대로 경로에 붙인다 (경로 조작)
