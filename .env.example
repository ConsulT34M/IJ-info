# cp .env.example .env 해서 쓴다. .env는 커밋하지 않는다.

FLASK_APP=app
# 맥의 AirPlay 수신이 5000을 쓰므로 8000으로 띄운다
FLASK_RUN_PORT=8000
FLASK_RUN_HOST=127.0.0.1

# 거래소에 돌려줄 auth_url의 앞부분
PUBLIC_BASE_URL=http://127.0.0.1:8000
# dev | production. dev에서는 로컬 http 때문에 세션 쿠키 Secure를 끈다(D22).
EKYC_ENV=dev

# 시크릿 파일 경로 (기본값: instance/dev_secrets.json)
# EKYC_SECRETS_FILE=instance/dev_secrets.json
# 개별 시크릿 덮어쓰기: EKYC_SECRET_<이름 대문자, / 와 - 는 _>
# EKYC_SECRET_EKYC_DB=postgresql+psycopg://ekyc:ekyc@127.0.0.1:5432/ekyc

# Apache 뒤에 둘 때만 true. true일 때만 X-Real-IP를 믿는다.
TRUST_PROXY=false

# pytest를 PostgreSQL로 돌릴 때만 설정한다(없으면 SQLite 메모리)
# TEST_DATABASE_URL=postgresql+psycopg://ekyc:ekyc@127.0.0.1:5432/ekyc_test

# 실습 전용 테스트 문자 수신함 허용 IP (진단 범위 제외)
TEST_INBOX_ALLOWED_IPS=127.0.0.1,::1

# 모의 통신사 (자체 서명 인증서 고정)
CARRIER_BASE_URL=https://localhost:8443
CARRIER_CA_BUNDLE=carrier/certs/carrier.crt

# 취약 플래그 (진단 실습용). 기본은 전부 false.
VULN_W08=false
VULN_W09=false
VULN_W10=false
VULN_W14=false
VULN_W17=false
VULN_C10=false
